# ==============================================================================
# SmartCrop AI - Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# --- Server Configuration ---
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
STREAMLIT_PORT=8501

# --- Inference Hardware Configuration ---
# Options: cpu, cuda, auto
DEVICE=auto
# Number of CPU threads for PyTorch intra-op parallelism
TORCH_NUM_THREADS=4

# --- Model Checkpoint Paths (Defaults point to local models/ directory) ---
PLANTDOC_CHECKPOINT=models/disease/disease_model_exp_D_best.pth
PLANTDOC_CLASSES=models/disease/disease_classes.json

IP102_CLS_CHECKPOINT=models/pest/ip102_convnext_best.pth
IP102_DET_CHECKPOINT=models/pest/yolov8_pest_best.pt
IP102_CLASSES=models/pest/classes.json

CROPHARVEST_BINARY_CHECKPOINT=models/cropharvest/binary/transformer_seeds.pth
CROPHARVEST_10CLASS_CHECKPOINT=models/cropharvest/10class/best_model.pth
CROPHARVEST_10CLASS_CLASSES=models/cropharvest/10class/classes.json

# --- Ultralytics Configuration ---
# Disable auto-install attempts via pip in isolated/production environments
YOLO_AUTOINSTALL=False
YOLO_VERBOSE=False

# --- Multimodal Vision-Language Advisory Layer (LFM3-VL-2B) ---
# Set to true only if high-VRAM GPU (>16 GB VRAM) is provisioned and weights downloaded
ENABLE_LFM3_VL=false
LFM3_VL_MODEL_ID=LiquidAI/LFM-3-VL-2B

